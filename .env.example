# get-me-in v2 环境变量配置模板
# 复制此文件为 .env，并填入实际值。R8 观察期内，legacy rollback only 段仅用于回退旧入口。

# OpenAI-compatible API 地址与密钥（必填）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# 主模型与轻量模型（必填）
LLM_PRO_MODEL=gpt-4o
LLM_FLASH_MODEL=gpt-4o-mini

# v2 模型、运行与显示配置
LLM_TIMEOUT=60
LLM_THINKING_ENABLED=true
SHOW_THINKING=false
AGENT_MAX_MODEL_CALLS=100
CANCEL_GRACE_SECONDS=2
SHUTDOWN_TIMEOUT_SECONDS=60
AUTO_MEMORY_ON_EXIT=false

# v2 静态输入与运行目录；reference/prompts/resume template 固定由项目目录提供
WORKSPACE_DIR=data/workspace
SESSIONS_DIR=data/v2/sessions
ARTIFACTS_DIR=data/v2/artifacts
LOG_DIR=data/logs
LOG_LEVEL=INFO

# v2 Knowledge/RAG 配置
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_BATCH_SIZE=32
RERANK_BATCH_SIZE=32
RETRIEVAL_TOP_K=8
HF_ENDPOINT=https://hf-mirror.com

# v2 仍接受以下旧名称作为兼容别名；新配置优先使用上方名称。
# BI_ENCODER_MODEL=BAAI/bge-base-zh-v1.5
# CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
# EMBED_BATCH_SIZE=32

# v2 Resume 构建配置
PDF_BUILD_TIMEOUT_SECONDS=60
ARTIFACT_LOG_MAX_BYTES=65536

# legacy rollback only —— 仅在 R8 观察期回退旧根入口时使用；v2 不读取这些变量。
# CHROMA_PERSIST_DIR=data/chroma
# MEMORIES_BASE_DIR=data/memories/
# AGENT_MAX_ROUNDS=10
# TOOL_CONFIRM_ENABLED=true
# WORKING_DIR=data/temp/
# SAVE_DIR=data/save/
