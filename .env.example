# get-me-in 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# OpenAI-compatible API 地址
OPENAI_BASE_URL=https://api.openai.com/v1

# API 密钥（必填）
OPENAI_API_KEY=sk-your-key-here

# Pro tier 模型 — 用于深度推理任务（简历分析、面试评估等）
LLM_PRO_MODEL=gpt-4o

# Flash tier 模型 — 用于轻量任务（意图分类、格式化输出等）
LLM_FLASH_MODEL=gpt-4o-mini

# Bi-encoder 模型 — 用于 RAG 召回（句向量化）
BI_ENCODER_MODEL=BAAI/bge-base-zh-v1.5

# Cross-encoder 模型 — 用于 RAG 重排（句对相似度）
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3

# Embedding 批处理大小（根据显存/内存调整，默认 32）
EMBED_BATCH_SIZE=32

# HuggingFace 镜像（国内用户建议使用 hf-mirror.com）
HF_ENDPOINT=https://hf-mirror.com
